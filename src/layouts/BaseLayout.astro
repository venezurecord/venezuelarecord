---
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LANG_META, LANGS, localePath, stripLang, t, type Lang } from '../i18n/ui';
import { SITE } from '../lib/constants';
import '../styles/global.css';

interface Props {
  lang: Lang;
  /** Page title without the site name (omit on the home page). */
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  /** ISO dates for article:published_time / modified_time */
  published?: Date;
  modified?: Date;
  jsonLd?: Record<string, unknown>;
  /** Set false on pages that have no counterpart in the other language (404). */
  alternates?: boolean;
  noindex?: boolean;
}

const {
  lang,
  title,
  description = t(lang, 'site.description'),
  image,
  imageAlt,
  ogType = 'website',
  published,
  modified,
  jsonLd,
  alternates = true,
  noindex = false,
} = Astro.props;

const site = Astro.site!;
const fullTitle = title ? `${title} | ${SITE.name}` : t(lang, 'home.title');
const canonical = new URL(Astro.url.pathname, site).href;
const basePath = stripLang(Astro.url.pathname);

let ogImage = new URL('/og-default.png', site).href;
let ogImageAlt = `${SITE.name} — ${t(lang, 'site.tagline')}`;
if (image) {
  const img = await getImage({ src: image, width: 1200, format: 'jpeg', quality: 80 });
  ogImage = new URL(img.src, site).href;
  ogImageAlt = imageAlt ?? ogImageAlt;
}

const ldJson = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang={LANG_META[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      alternates &&
        LANGS.map((l) => (
          <link rel="alternate" hreflang={l} href={new URL(localePath(l, basePath), site).href} />
        ))
    }
    {alternates && <link rel="alternate" hreflang="x-default" href={new URL(basePath, site).href} />}
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} (${LANG_META[lang].label})`} href={localePath(lang, '/rss.xml')} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1115" media="(prefers-color-scheme: dark)" />

    <Font cssVariable="--font-serif" preload={[{ weight: 400, style: 'normal', subset: 'latin' }, { weight: 700, style: 'normal', subset: 'latin' }, { weight: 400, style: 'italic', subset: 'latin' }]} />
    <Font cssVariable="--font-inter" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LANG_META[lang].ogLocale} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LANG_META[l].ogLocale} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {ldJson && <script type="application/ld+json" set:html={ldJson} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'skip')}</a>
    <Header lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  main {
    display: block;
    min-height: 60vh;
    padding-bottom: 64px;
  }
  main:focus {
    outline: none;
  }
</style>
