    font: 500 0.88rem/1.5 var(--sans);
    padding-block: 12px;
  }
  .draft .d-final {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 6px;
    padding: 0 14px;
    border-radius: 8px;
    background: #111;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }
