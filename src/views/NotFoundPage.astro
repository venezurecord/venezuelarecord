---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<BaseLayout lang={lang} title={t(lang, 'notFound.title')} alternates={false} noindex>
  <div class="container">
    <div class="reading not-found">
      <p class="code" aria-hidden="true">404</p>
      <h1 class="page-title">{t(lang, 'notFound.title')}</h1>
      <p class="page-intro">{t(lang, 'notFound.text')}</p>
      <p><a href={localePath(lang, '/')}>{t(lang, 'notFound.home')}</a> · <a href={localePath(lang, '/timeline/')}>{t(lang, 'nav.timeline')}</a></p>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding-top: 40px;
    text-align: center;
  }
  .not-found .page-intro {
    margin-inline: auto;
  }
  .code {
    font-family: var(--serif);
    font-size: 4rem;
    font-weight: 700;
    color: var(--muted);
    margin: 0;
    line-height: 1;
  }
</style>
