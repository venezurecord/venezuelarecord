---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroGrid from '../components/HeroGrid.astro';
import CategorySection from '../components/CategorySection.astro';
import InvestigationCard from '../components/investigation/InvestigationCard.astro';
import { INVESTIGATIONS } from '../data/investigations';
import { it } from '../data/investigations/ui';
import { CATEGORIES, SITE } from '../lib/constants';
import { displayImage, getStories } from '../lib/news';
import { localePath, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const stories = await getStories(lang); // newest first by original date

// Hero: the most recent featured story (or the most recent one), then the next
// two as medium cards, then five more in "Latest". The hero ALWAYS has a photo
// (Roger, 2026-10-09): stories without one (source card) are skipped for it.
const withPhoto = stories.filter((s) => displayImage(s));
const featured = withPhoto.find((s) => s.data.featured) ?? withPhoto[0] ?? stories[0];
const rest = stories.filter((s) => s !== featured);
const side = rest.slice(0, 2);
const latest = rest.slice(2, 7);

const sections = CATEGORIES.map((c) => ({
  category: c,
  stories: stories.filter((s) => s.data.category === c).slice(0, 4),
})).filter((s) => s.stories.length > 0);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: new URL(lang === 'en' ? '/' : '/es/', Astro.site).href,
  inLanguage: lang,
  description: t(lang, 'site.description'),
};
---

<BaseLayout lang={lang} jsonLd={jsonLd}>
  <div class="container">
    <h1 class="visually-hidden">{SITE.name} — {t(lang, 'site.tagline')}</h1>
    {
      featured ? (
        <HeroGrid lang={lang} featured={featured} side={side} latest={latest} />
      ) : (
        <p class="empty-state">{t(lang, 'home.empty')}</p>
      )
    }

    {
      INVESTIGATIONS[0] && (
        <section class="home-inv" aria-labelledby="home-inv-h">
          <div class="section-head">
            <h2 id="home-inv-h">{it(lang, 'homeKicker')}</h2>
            <a href={localePath(lang, '/investigations/')}>{t(lang, 'home.viewAll')} »</a>
          </div>
          <InvestigationCard lang={lang} inv={INVESTIGATIONS[0]} headingLevel={3} />
        </section>
      )
    }

    {sections.map((s) => <CategorySection lang={lang} category={s.category} stories={s.stories} />)}
  </div>
</BaseLayout>

<style>
  .home-inv {
    margin: 40px 0 8px;
  }
</style>
