---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InvestigationCard from '../../components/investigation/InvestigationCard.astro';
import type { Lang } from '../../i18n/ui';
import { INVESTIGATIONS } from '../../data/investigations';
import { it } from '../../data/investigations/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<BaseLayout lang={lang} title={it(lang, 'indexTitle')} description={it(lang, 'indexIntro')}>
  <div class="container">
    <h1 class="page-title">{it(lang, 'indexTitle')}</h1>
    <p class="page-intro">{it(lang, 'indexIntro')}</p>
    <ul class="inv-list">
      {
        INVESTIGATIONS.map((inv) => (
          <li>
            <InvestigationCard lang={lang} inv={inv} />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .inv-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 28px;
  }
</style>
