---
// Investigation 2: "The Capacity to Persecute Is Still There" / "La capacidad de perseguir sigue ahí".
// Author: Venezuela Record (organization). Original idea credited on the page and in the card.
// Phone first: a short hero with the two figures that frame the piece, then figures → three components → method.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareBar from '../../components/ShareBar.astro';
import InvToc from '../../components/investigation/InvToc.astro';
import InvCover from '../../components/investigation/InvCover.astro';
import FpSeries from '../../components/investigation/FpSeries.astro';
import Capacity from '../../components/investigation/Capacity.astro';
import PieceMethod from '../../components/investigation/PieceMethod.astro';
import Cite from '../../components/investigation/Cite.astro';
import '../../styles/investigation.css';
import { getImage } from 'astro:assets';
import { localePath, type Lang } from '../../i18n/ui';
import { SITE } from '../../lib/constants';
import { META, R_ANCHORS, R_UI, SOURCES } from '../../data/investigations/residual-capacity-2026';
import { META as PART1 } from '../../data/investigations/who-commands-venezuela-2026';
import { it, longDate, ideaCredit } from '../../data/investigations/ui';
import { investigationUrl } from '../../data/investigations';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const A = R_ANCHORS[lang];
const U = R_UI[lang];
const url = new URL(investigationUrl(lang, META.slug), Astro.site).href;
const part1Url = investigationUrl(lang, PART1.slug);
const title = META.title[lang];
const social = await getImage({ src: META.social[lang], format: 'png', width: 1200 });
const fmt = (n: number) => (lang === 'es' ? String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.') : n.toLocaleString('en-US'));

const toc = [
  { id: A.fig, label: U.toc.fig },
  { id: 'cap-p1', label: U.toc.p1 },
  { id: 'cap-p2', label: U.toc.p2 },
  { id: 'cap-p3', label: U.toc.p3 },
  { id: A.src, label: U.toc.src },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  alternativeHeadline: META.subtitle[lang],
  description: META.summary[lang],
  inLanguage: lang,
  url,
  mainEntityOfPage: url,
  image: new URL(social.src, Astro.site).href,
  datePublished: META.published,
  dateModified: META.updated,
  author: { '@type': 'Organization', name: SITE.name, url: new URL('/', Astro.site).href },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: new URL('/', Astro.site).href,
    logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', Astro.site).href },
  },
  contributor: { '@type': 'Person', name: META.ideaBy, description: lang === 'en' ? 'Original idea' : 'Idea original' },
  isAccessibleForFree: true,
  isPartOf: { '@type': 'CreativeWorkSeries', name: lang === 'en' ? 'Venezuela Record investigations' : 'Investigaciones de Venezuela Record' },
  about: [{ '@type': 'Place', name: 'Venezuela' }, { '@type': 'Organization', name: 'Foro Penal' }],
  citation: SOURCES.filter((s) => s.url).map((s) => ({
    '@type': 'CreativeWork',
    name: s.title[lang],
    url: s.url,
    publisher: { '@type': 'Organization', name: s.outlet },
  })),
};
---

<BaseLayout
  lang={lang}
  title={title}
  description={META.summary[lang]}
  image={META.social[lang]}
  imageAlt={`${title} — ${META.subtitle[lang]}`}
  ogType="article"
  published={new Date(`${META.published}T12:00:00Z`)}
  modified={new Date(`${META.updated}T12:00:00Z`)}
  jsonLd={jsonLd}
>
  <article class="inv">
    <header class="rc-hero">
      {
        META.hero ? (
          <InvCover lang={lang} image={META.hero} alt={META.heroAlt?.[lang] ?? ''} kicker={U.kicker} title={title} subtitle={META.subtitle[lang]} credit={META.coverCredit} posPhone="72% 50%" posDesk="60% 50%" />
        ) : (
          <div class="rc-in rc-plain">
            <p class="rc-kicker">{U.kicker}</p>
            <h1>{title}</h1>
            <p class="rc-sub">{META.subtitle[lang]}</p>
          </div>
        )
      }
      <div class="rc-in rc-after">
        <div class="rc-figs">
          <p class="rc-fig a"><b>{fmt(1104)}</b><span>{U.heroA}</span></p>
          <p class="rc-fig b"><b>{fmt(11468)}</b><span>{U.heroB}</span></p>
        </div>
        <p class="rc-src">{U.heroSrc}<Cite lang={lang} ids={[1]} anchor={A.src} /></p>
        <p class="rc-credit" set:html={ideaCredit(lang, META)} />
        <p class="rc-meta">
          <time datetime={META.published}>{longDate(lang, META.published)}</time> · {U.readTime}
        </p>
        <a class="rc-prev" href={part1Url}>
          <span class="l">{U.part1Label}</span>
          <span class="t">{PART1.title[lang]}</span>
        </a>
      </div>
    </header>

    <InvToc lang={lang} items={toc} />

    <section id={A.fig} class="rc-sec" aria-labelledby="rc-fig-title">
      <header class="inv-head">
        <p class="inv-kicker">{U.figKicker}</p>
        <h2 id="rc-fig-title">{U.figTitle}</h2>
        <p class="inv-intro">{U.figIntro}</p>
      </header>
      <FpSeries lang={lang} heading={false} />
    </section>

    <Capacity lang={lang} />

    <PieceMethod lang={lang} meta={META} sources={SOURCES} anchor={A.src} body={U.methodBody} warning={U.methodWarning} unverified={[...U.unverified]} />

    <div class="inv-share">
      <a class="rc-prev bottom" href={part1Url}>
        <span class="l">{U.prevKicker}</span>
        <span class="t">{PART1.title[lang]}</span>
      </a>
      <ShareBar lang={lang} url={url} title={title} />
      <p><a href={localePath(lang, '/investigations/')}>← {it(lang, 'indexTitle')}</a></p>
    </div>
  </article>
</BaseLayout>

<style>
  .rc-hero {
    background: #0b0f17;
    color: #f3f0e8;
    padding-block: 0 36px;
  }
  .rc-plain {
    padding-top: 40px;
  }
  .rc-after {
    padding-top: 28px;
  }
  .rc-in {
    max-width: 880px;
    margin: 0 auto;
    padding-inline: var(--gutter);
  }
  .rc-kicker {
    margin: 0 0 12px;
    font: 700 0.76rem/1.4 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ffcc00;
  }
  .rc-hero h1 {
    margin: 0 0 14px;
    font: 700 clamp(2.3rem, 9vw, 4.2rem)/1.02 var(--serif);
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: #f3f0e8;
  }
  .rc-sub {
    max-width: 680px;
    margin: 0 0 24px;
    font: 400 clamp(1.08rem, 2.6vw, 1.3rem)/1.5 var(--serif);
    color: #c9c5bc;
  }
  .rc-figs {
    display: grid;
    gap: 18px;
  }
  @media (min-width: 700px) {
    .rc-figs {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }
  .rc-fig {
    margin: 0;
  }
  .rc-fig b {
    display: block;
    font: 700 clamp(3.4rem, 15vw, 5.6rem)/0.95 var(--serif);
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .rc-fig.a b {
    color: #4fc28a;
  }
  .rc-fig.b b {
    color: #f2a93b;
  }
  .rc-fig span {
    display: block;
    margin-top: 8px;
    max-width: 22rem;
    font: 500 1rem/1.4 var(--sans);
    color: #e6e2d8;
  }
  .rc-src {
    margin: 14px 0 0;
    font: 0.84rem/1.4 var(--sans);
    color: #a9b0bd;
  }
  .rc-src :global(.cite a) {
    color: #9fb5ff;
  }
  .rc-credit {
    margin: 22px 0 4px;
    font: 0.95rem/1.5 var(--sans);
    color: #e6e2d8;
  }
  .rc-meta {
    margin: 0;
    font: 0.86rem/1.4 var(--sans);
    color: #a9b0bd;
  }
  .rc-prev {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 22px;
    padding: 12px 16px;
    min-height: 44px;
    border: 1px solid #2a2e36;
    border-radius: 10px;
    color: #f3f0e8;
    text-decoration: none;
    max-width: 440px;
  }
  .rc-prev:hover {
    border-color: #f3f0e8;
  }
  .rc-prev .l {
    font: 700 0.7rem/1.3 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffcc00;
  }
  .rc-prev .t {
    font: 700 1.05rem/1.3 var(--serif);
  }
  .rc-prev.bottom {
    margin: 0 0 20px;
    background: #0b0f17;
  }
  .rc-sec {
    padding-block: 64px 8px;
  }
</style>
