---
// Investigation: "Venezuela 2026: The Post-Maduro Power Structure" / "Venezuela 2026: La estructura del poder post-Maduro".
// Author: Venezuela Record (organization). Original idea credited on the page and in the card.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareBar from '../../components/ShareBar.astro';
import Opening from '../../components/investigation/Opening.astro';
import InvCover from '../../components/investigation/InvCover.astro';
import Signatures from '../../components/investigation/Signatures.astro';
import OrgChart from '../../components/investigation/OrgChart.astro';
import TwoLanes from '../../components/investigation/TwoLanes.astro';
import Gazettes from '../../components/investigation/Gazettes.astro';
import Penalties from '../../components/investigation/Penalties.astro';
import VenApp from '../../components/investigation/VenApp.astro';
import CrystalVault from '../../components/investigation/CrystalVault.astro';
import Balance from '../../components/investigation/Balance.astro';
import Method from '../../components/investigation/Method.astro';
import InvToc from '../../components/investigation/InvToc.astro';
import NextPart from '../../components/investigation/NextPart.astro';
import '../../styles/investigation.css';
import { getImage } from 'astro:assets';
import { localePath, type Lang } from '../../i18n/ui';
import { SITE } from '../../lib/constants';
import { META, SOURCES } from '../../data/investigations/who-commands-venezuela-2026';
import { ANCHORS, it, TOC_LABELS } from '../../data/investigations/ui';
import { investigationUrl } from '../../data/investigations';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const A = ANCHORS[lang];
const T = TOC_LABELS[lang];
const url = new URL(investigationUrl(lang, META.slug), Astro.site).href;
const title = META.title[lang];
const social = await getImage({ src: META.social[lang], format: 'png', width: 1200 });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  alternativeHeadline: META.subtitle[lang],
  description: META.summary[lang],
  inLanguage: lang,
  url,
  mainEntityOfPage: url,
  image: new URL(social.src, Astro.site).href,
  datePublished: META.published,
  dateModified: META.updated,
  author: { '@type': 'Organization', name: SITE.name, url: new URL('/', Astro.site).href },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: new URL('/', Astro.site).href,
    logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', Astro.site).href },
  },
  contributor: { '@type': 'Person', name: META.ideaBy, description: META.ideaRole?.[lang] ?? (lang === 'en' ? 'Original idea' : 'Idea original') },
  isAccessibleForFree: true,
  about: [
    { '@type': 'Place', name: 'Venezuela' },
    { '@type': 'Person', name: 'Delcy Rodríguez' },
  ],
  citation: SOURCES.filter((s) => s.url).map((s) => ({
    '@type': 'CreativeWork',
    name: s.title[lang],
    url: s.url,
    publisher: { '@type': 'Organization', name: s.outlet },
  })),
};

const toc = [
  { id: A.sig, label: T.sig },
  { id: A.org, label: T.org },
  { id: A.tl, label: T.tl },
  { id: A.gz, label: T.gz },
  { id: A.pen, label: T.pen },
  { id: A.va, label: T.va },
  { id: A.bv, label: T.bv },
  { id: A.bal, label: T.bal },
  { id: A.src, label: T.src },
];
---

<BaseLayout
  lang={lang}
  title={title}
  description={META.summary[lang]}
  image={META.social[lang]}
  imageAlt={`${title} — ${META.subtitle[lang]}`}
  ogType="article"
  published={new Date(`${META.published}T12:00:00Z`)}
  modified={new Date(`${META.updated}T12:00:00Z`)}
  jsonLd={jsonLd}
>
  <article class="inv">
    {
      META.hero && (
        <InvCover lang={lang} image={META.hero} alt={META.heroAlt?.[lang] ?? ''} kicker={`${it(lang, 'kicker')} · ${it(lang, 'original')}`} title={title} subtitle={META.subtitle[lang]} credit={META.coverCredit} posPhone="95% 50%" posDesk="50% 50%" titleId="inv-title" />
      )
    }
    <Opening lang={lang} titled={!META.hero} intro={META.intro?.[lang]} />

    <InvToc lang={lang} items={toc} />

    <Signatures lang={lang} />
    <OrgChart lang={lang} />
    <TwoLanes lang={lang} />
    <Gazettes lang={lang} />
    <Penalties lang={lang} />
    <VenApp lang={lang} />
    <CrystalVault lang={lang} />
    <Balance lang={lang} />
    <NextPart lang={lang} />
    <Method lang={lang} />

    <div class="inv-share">
      <ShareBar lang={lang} url={url} title={title} />
      <p><a href={localePath(lang, '/investigations/')}>← {it(lang, 'indexTitle')}</a></p>
    </div>
  </article>
</BaseLayout>
