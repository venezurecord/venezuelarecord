---
import Nav from './Nav.astro';
import LangSwitch from './LangSwitch.astro';
import Masthead from './Masthead.astro';
import { localePath, stripLang, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
// Phones: slim sticky bar (menu · logo · language); the tagline only on the home page.
const isHome = stripLang(Astro.url.pathname) === '/';
---

<header class:list={['site-header', { 'is-home': isHome }]}>
  <div class="container header-inner">
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path class="bar" d="M3 6h18M3 12h18M3 18h18"></path>
      </svg>
      <span class="visually-hidden">{t(lang, 'nav.menu')}</span>
    </button>

    <div class="brand">
      <a class="wordmark" href={localePath(lang, '/')}>
        <Masthead maxWidth={560} sizes="(min-width: 900px) 560px, calc(100vw - 140px)" eager />
      </a>
      <p class="tagline">{t(lang, 'site.tagline')}</p>
    </div>

    <LangSwitch lang={lang} />
  </div>
  <Nav lang={lang} />
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  if (btn && nav) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        set(false);
        btn.focus();
      }
    });
    matchMedia('(min-width: 900px)').addEventListener('change', () => set(false));
  }
</script>

<style>
  .site-header {
    background: var(--bg);
  }
  .header-inner {
    display: grid;
    grid-template-columns: 44px 1fr 44px;
    align-items: center;
    gap: 8px;
    padding-block: 10px;
  }
  /* Phones and tablets: sticky bar, like a news app */
  @media (max-width: 899px) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      box-shadow: 0 1px 0 var(--line);
    }
    .site-header :global(#site-nav.is-open) {
      max-height: calc(100dvh - 64px);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .site-header:not(.is-home) .tagline {
      display: none;
    }
    /* Without JS the menu is always expanded: don't pin it */
    :global(html:not(.js)) .site-header {
      position: static;
    }
  }
  .brand {
    text-align: center;
    min-width: 0;
  }
  .wordmark {
    display: block;
    width: min(560px, 100%);
    margin-inline: auto;
    padding-block: 8px; /* tap target on very small phones */
    margin-block: -8px;
  }
  .tagline {
    margin: 6px 0 2px;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(0.78rem, 2.4vw, 1rem);
    line-height: 1.35;
    color: var(--muted);
  }
  .menu-toggle {
    width: 44px;
    height: 44px;
    display: inline-grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  :global(html:not(.js)) .menu-toggle {
    visibility: hidden;
  }
  @media (min-width: 900px) {
    .header-inner {
      grid-template-columns: 120px 1fr 120px;
      padding-block: 28px 20px;
    }
    .menu-toggle {
      visibility: hidden;
    }
  }
</style>
