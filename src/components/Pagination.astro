---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  current: number; // 1-based
  total: number;
  /** Base path of page 1, e.g. "/category/opinion/" — page n is base + n + "/" */
  base: string;
}
const { lang, current, total, base } = Astro.props;
const pageUrl = (n: number) => (n === 1 ? base : `${base}${n}/`);
---

{
  total > 1 && (
    <nav class="pagination" aria-label={t(lang, 'pagination.label')}>
      {current > 1 ? (
        <a href={pageUrl(current - 1)} rel="prev">
          <span aria-hidden="true">«</span> {t(lang, 'pagination.prev')}
        </a>
      ) : (
        <span />
      )}
      <span class="status">{t(lang, 'pagination.page', { n: current, total })}</span>
      {current < total ? (
        <a href={pageUrl(current + 1)} rel="next">
          {t(lang, 'pagination.next')} <span aria-hidden="true">»</span>
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}

<style>
  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    margin-top: 40px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }
  a {
    display: inline-block;
    padding: 10px 0;
    font-weight: 600;
    text-decoration: none;
  }
  a[rel='next'] {
    justify-self: end;
  }
  .status {
    color: var(--muted);
  }
</style>
