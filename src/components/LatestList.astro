---
import { Image } from 'astro:assets';
import SourceCard from './SourceCard.astro';
import PendingBadge from './PendingBadge.astro';
import { displayImage, formatDate, isoDate, storyUrl, type Story } from '../lib/news';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  stories: Story[];
  title?: string;
}
const { lang, stories, title = t(lang, 'home.latest') } = Astro.props;
---

<section class="latest" aria-labelledby="latest-title">
  <h2 id="latest-title" class="head">{title}</h2>
  <ol>
    {
      stories.map((s) => {
        const img = displayImage(s);
        return (
          <li>
            <div class="text">
              <h3>
                <a href={storyUrl(s)}>{s.title}</a>
              </h3>
              <p class="meta">
                <time datetime={isoDate(s.data.originalDate)}>{formatDate(lang, s.data.originalDate)}</time> · {s.data.sourceName}{' '}
                <PendingBadge story={s} />
              </p>
            </div>
            <a class="thumb" href={storyUrl(s)} tabindex="-1" aria-hidden="true">
              {img ? (
                <Image src={img} alt={s.imageAlt} width={160} widths={[96, 160]} sizes="80px" format="webp" quality={65} />
              ) : (
                <SourceCard lang={lang} sourceName={s.data.sourceName} size="small" />
              )}
            </a>
          </li>
        );
      })
    }
  </ol>
</section>

<style>
  .head {
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 4px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 1fr 80px;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  li:last-child {
    border-bottom: 0;
  }
  h3 {
    font-size: 0.98rem;
    line-height: 1.3;
    margin: 0 0 6px;
  }
  h3 a {
    color: var(--text);
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .meta {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .thumb {
    text-decoration: none;
  }
  .thumb :global(img) {
    width: 80px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
</style>
