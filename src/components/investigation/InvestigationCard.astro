---
// Featured investigation block (home page and /investigations/). Always shows the idea credit.
import { Image } from 'astro:assets';
import type { Lang } from '../../i18n/ui';
import type { InvestigationMeta } from '../../data/investigations/types';
import { investigationUrl } from '../../data/investigations';
import { it, longDate } from '../../data/investigations/ui';

interface Props {
  lang: Lang;
  inv: InvestigationMeta;
  headingLevel?: 2 | 3;
}
const { lang, inv, headingLevel = 2 } = Astro.props;
const href = investigationUrl(lang, inv.slug);
const H = `h${headingLevel}` as 'h2' | 'h3';
---

<article class:list={["ic", { photo: !!inv.coverCredit }]}>
  <a class="ic-media" href={href} tabindex="-1" aria-hidden="true">
    <Image src={inv.cover ?? inv.social[lang]} alt="" widths={[480, 800, 1200]} sizes="(min-width: 900px) 560px, 100vw" loading="lazy" decoding="async" />
  </a>
  <div class="ic-body">
    <p class="ic-kicker">{it(lang, 'homeKicker')} · {it(lang, 'original')}</p>
    <H class="ic-title"><a href={href}>{inv.title[lang]}</a></H>
    <p class="ic-sub">{inv.subtitle[lang]}</p>
    <p class="ic-sum">{inv.summary[lang]}</p>
    <p class="ic-credit" set:html={it(lang, 'ideaCredit', { name: inv.ideaBy })} />
    <p class="ic-meta"><time datetime={inv.updated}>{it(lang, 'updated', { date: longDate(lang, inv.updated) })}</time></p>
    {inv.coverCredit && <p class="ic-photo">{inv.coverCredit.url ? <a href={inv.coverCredit.url} rel="noopener license" target="_blank">{inv.coverCredit.text[lang]}</a> : inv.coverCredit.text[lang]}</p>}
    <a class="ic-cta" href={href}>{it(lang, 'readInvestigation')} <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .ic {
    display: grid;
    gap: 0;
    background: #0b0f17;
    color: #f3f0e8;
    border-radius: 10px;
    overflow: hidden;
  }
  @media (min-width: 900px) {
    .ic {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }
  .ic-media {
    display: block;
    aspect-ratio: 1200 / 630;
    overflow: hidden;
  }
  .ic-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  /* Photo covers fill the whole height of the card on wide screens (illustrations keep their frame). */
  @media (min-width: 900px) {
    .ic.photo .ic-media {
      aspect-ratio: auto;
      height: 100%;
      min-height: 320px;
    }
    .ic.photo .ic-media :global(img) {
      object-position: 62% 60%;
    }
  }
  .ic:hover .ic-media :global(img) {
    transform: scale(1.03);
  }
  .ic-body {
    padding: 22px 22px 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .ic-kicker {
    margin: 0 0 8px;
    font: 700 0.76rem/1.4 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--vz-yellow);
  }
  .ic-title {
    font-size: clamp(1.7rem, 3.6vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0 0 10px;
  }
  .ic-title a {
    color: inherit;
    text-decoration: none;
  }
  .ic-title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .ic-sub {
    margin: 0 0 12px;
    font: 1.05rem/1.4 var(--serif);
    color: #d9d5cc;
  }
  .ic-sum {
    margin: 0 0 14px;
    font: 0.95rem/1.55 var(--sans);
    color: #c3c8d1;
  }
  .ic-credit,
  .ic-meta {
    margin: 0;
    font: 0.85rem/1.5 var(--sans);
    color: #a9b0bd;
  }
  .ic-credit :global(strong) {
    color: #f3f0e8;
  }
  .ic-cta {
    align-self: flex-start;
    margin-top: 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--vz-yellow);
    color: #111;
    font: 700 0.92rem var(--sans);
    text-decoration: none;
  }
  .ic-cta:hover {
    background: #ffe066;
  }
  .ic :global(:focus-visible) {
    outline-color: var(--vz-yellow);
  }
  .ic-photo {
    margin: 6px 0 0;
    font: 0.72rem/1.4 var(--sans);
    color: #8b93a1;
  }
  .ic-photo a {
    color: inherit;
  }
</style>
