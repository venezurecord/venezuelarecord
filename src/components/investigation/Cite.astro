---
// Numbered source references: [1, 12] → superscript links. With JS and the Popover API they open a
// source card (Method.astro) with a direct link to the original document; otherwise they jump to the list.
import type { Lang } from '../../i18n/ui';
import { it } from '../../data/investigations/ui';

interface Props {
  lang: Lang;
  ids: number[];
  anchor: string; // id prefix of the source list items, e.g. "src"
}
const { lang, ids, anchor } = Astro.props;
---

{
  ids.length > 0 && (
    <sup class="cite">
      {ids.map((n, i) => (
        <>
          {i > 0 && <span aria-hidden="true">,</span>}
          <a href={`#${anchor}-${n}`} data-pop={`${anchor}-pop-${n}`} aria-label={it(lang, 'sourceN', { n })}>
            {n}
          </a>
        </>
      ))}
    </sup>
  )
}

<style>
  .cite {
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 0;
    margin-left: 2px;
    white-space: nowrap;
  }
  /* Small text, but a finger-sized hit area (padding that does not change the line height). */
  .cite a {
    display: inline-block;
    min-width: 1.6em;
    padding: 22px 4px;
    margin: -22px 0;
    text-align: center;
    text-decoration: none;
    color: var(--accent);
  }
  .cite a:hover,
  .cite a:focus-visible {
    text-decoration: underline;
  }
</style>
