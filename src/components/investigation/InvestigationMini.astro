---
// Compact investigation card (home page, below the featured one): thumbnail, title, subtitle and link.
import { Image } from 'astro:assets';
import type { Lang } from '../../i18n/ui';
import type { InvestigationMeta } from '../../data/investigations/types';
import { investigationUrl } from '../../data/investigations';
import { it, longDate } from '../../data/investigations/ui';

interface Props {
  lang: Lang;
  inv: InvestigationMeta;
}
const { lang, inv } = Astro.props;
const href = investigationUrl(lang, inv.slug);
---

<article class="im">
  <a class="im-media" href={href} tabindex="-1" aria-hidden="true">
    <Image src={inv.cover ?? inv.social[lang]} alt="" widths={[240, 480]} sizes="(min-width: 700px) 240px, 120px" loading="lazy" decoding="async" />
  </a>
  <div class="im-body">
    <p class="im-kicker">{it(lang, 'homeKicker')} · <time datetime={inv.published}>{longDate(lang, inv.published)}</time></p>
    <h3 class="im-title"><a href={href}>{inv.title[lang]}</a></h3>
    <p class="im-sub">{inv.subtitle[lang]}</p>
    {inv.coverCredit && <p class="im-photo">{inv.coverCredit.text[lang]}</p>}
  </div>
</article>

<style>
  .im {
    position: relative;
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    margin-top: 14px;
    padding: 12px;
    background: #0b0f17;
    color: #f3f0e8;
    border-radius: 10px;
  }
  @media (min-width: 700px) {
    .im {
      grid-template-columns: 240px minmax(0, 1fr);
      gap: 22px;
      align-items: center;
      padding: 14px;
    }
  }
  .im-media {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 6px;
  }
  @media (min-width: 700px) {
    .im-media {
      aspect-ratio: 1200 / 630;
    }
  }
  .im-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 50%;
  }
  .im-kicker {
    margin: 0 0 6px;
    font: 700 0.7rem/1.4 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--vz-yellow);
  }
  .im-title {
    margin: 0 0 6px;
    font: 700 clamp(1.15rem, 2.6vw, 1.5rem)/1.15 var(--serif);
  }
  .im-title a {
    color: inherit;
    text-decoration: none;
  }
  /* The whole card is clickable through the title link. */
  .im-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 10px;
  }
  .im-title a:hover {
    text-decoration: underline;
  }
  .im-sub {
    margin: 0;
    font: 0.92rem/1.45 var(--serif);
    color: #c9c5bc;
  }
  .im-photo {
    margin: 6px 0 0;
    font: 0.7rem/1.4 var(--sans);
    color: #8b93a1;
  }
  .im :global(:focus-visible) {
    outline-color: var(--vz-yellow);
  }
</style>
