---
// VenApp, 2022 → 2026: a step line. The 2026 step is a documented official use (emergencies), flagged as such;
// the political-reporting functions are not confirmed for 2026. Texts: Minerva Mendoza Paipa (2026-10-22).
import type { Lang } from '../../i18n/ui';
import { VA_TEXT, VENAPP } from '../../data/investigations/who-commands-venezuela-2026';
import { ANCHORS, it } from '../../data/investigations/ui';
import Cite from './Cite.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const A = ANCHORS[lang];
---

<section id={A.va} class="va" aria-labelledby="va-title">
  <header class="inv-head">
    <p class="inv-kicker">{it(lang, 'vaKicker')}</p>
    <h2 id="va-title">{it(lang, 'vaTitle')}</h2>
    {VA_TEXT.intro[lang].split('\n\n').map((p) => <p class="inv-intro">{p}</p>)}
  </header>
  <ol class="va-steps">
    {
      VENAPP.map((v) => (
        <li class:list={{ unc: v.uncertain, flagged: !!v.flag }}>
          <span class="va-dot" aria-hidden="true" />
          <p class="va-when">
            {v.when[lang]}
            {v.uncertain && <span class="va-flag">{it(lang, 'vaUncertain')}</span>}
            {v.flag && <span class="va-flag doc">{v.flag[lang]}</span>}
          </p>
          <p class="va-text">
            {v.text[lang]}
            <Cite lang={lang} ids={v.src} anchor={A.src} />
          </p>
        </li>
      ))
    }
  </ol>
  <div class="va-after">
    <p class="va-cidh">
      {VA_TEXT.cidh[lang]}
      <Cite lang={lang} ids={[50]} anchor={A.src} />
    </p>
    <blockquote class="va-pull">
      <p class="va-pull-k">{it(lang, 'vaPull')}</p>
      <p>{VA_TEXT.pull[lang]}</p>
    </blockquote>
  </div>
</section>

<style>
  .va {
    padding-block: 72px 32px;
  }
  .va-steps {
    list-style: none;
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: grid;
    gap: 0;
  }
  .va-steps li {
    position: relative;
    padding: 0 0 26px 34px;
  }
  .va-steps li::before {
    content: '';
    position: absolute;
    left: 8px;
    top: 10px;
    bottom: -10px;
    border-left: 3px solid var(--text);
  }
  .va-steps li:last-child::before {
    display: none;
  }
  .va-dot {
    position: absolute;
    left: 0;
    top: 4px;
    width: 19px;
    height: 19px;
    border-radius: 50%;
    background: var(--text);
    border: 3px solid var(--bg);
    box-shadow: 0 0 0 2px var(--text);
  }
  .unc .va-dot {
    background: var(--bg);
    box-shadow: 0 0 0 2px var(--muted);
    border-style: dashed;
  }
  .va-when {
    margin: 0 0 4px;
    font: 700 1.05rem/1.3 var(--sans);
  }
  .va-flag {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 8px;
    border: 1px dashed var(--muted);
    border-radius: 999px;
    font: 700 0.75rem/1.4 var(--sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    vertical-align: 2px;
  }
  .va-flag.doc {
    border-style: solid;
    border-color: var(--inv-appoint);
    color: var(--inv-appoint);
  }
  .va-after {
    max-width: 760px;
    margin: 12px auto 0;
    padding-inline: var(--gutter);
  }
  .va-cidh {
    margin: 0 0 22px;
    font: 1.04rem/1.6 var(--serif);
  }
  .va-pull {
    margin: 0;
    padding: 18px 0 18px 20px;
    border-left: 4px solid var(--inv-sec);
  }
  .va-pull p {
    margin: 0;
    font: italic 600 clamp(1.15rem, 2.8vw, 1.4rem)/1.45 var(--serif);
  }
  .va-pull .va-pull-k {
    margin-bottom: 6px;
    font: 700 0.7rem/1.4 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--inv-sec-strong);
  }
  @media (prefers-color-scheme: dark) {
    .va-pull .va-pull-k {
      color: var(--inv-sec);
    }
  }
  .va-text {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.04rem;
    line-height: 1.55;
    max-width: 52ch;
  }
  .unc .va-text {
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .va-steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 18px;
    }
    .va-steps li {
      padding: 36px 0 0;
    }
    .va-steps li::before {
      left: 10px;
      right: -28px;
      top: 9px;
      bottom: auto;
      border-left: 0;
      border-top: 3px solid var(--text);
    }
  }
</style>
