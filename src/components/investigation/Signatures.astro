---
// "The signature": real gazette crops; a highlighter stroke draws over Delcy Rodríguez's name and
// post(s) when each document scrolls into view. No JS / reduced motion: highlights already drawn.
import { Image } from 'astro:assets';
import type { Lang } from '../../i18n/ui';
import { SIGNATURES, SIG_OUTRO } from '../../data/investigations/who-commands-venezuela-2026';
import { ANCHORS, it } from '../../data/investigations/ui';
import Cite from './Cite.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const A = ANCHORS[lang];
---

<section id={A.sig} class="sig" aria-labelledby="sig-title">
  <header class="inv-head">
    <p class="inv-kicker">{it(lang, 'sigKicker')}</p>
    <h2 id="sig-title">{it(lang, 'sigTitle')}</h2>
    {it(lang, 'sigIntro').split('\n\n').map((p) => <p class="inv-intro">{p}</p>)}
  </header>

  <nav class="sig-ledger" aria-label={it(lang, 'sigLedger')}>
    <ol>
      {
        SIGNATURES.map((s) => (
          <li class:list={{ alone: s.alone }}>
            <a href={`#${s.id}`}>
              <span class="yr">{s.year}</span>
              <span class="posts">
                {s.roles.map((r) => (
                  <span class="post">{r[lang]}</span>
                ))}
              </span>
              {s.roles.length > 1 && <span class="x2" aria-hidden="true">×2</span>}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <p class="tile-hint" aria-hidden="true">{it(lang, 'tileHint')}</p>
  <div class="sig-steps" data-tiles role="region" aria-label={it(lang, 'sigLedger')}>
    {
      SIGNATURES.map((s) => (
        <article class:list={['sig-step', { alone: s.alone }]} id={s.id} aria-labelledby={`${s.id}-t`} data-tile>
          <div class="sig-text">
            <p class="sig-year" aria-hidden="true">
              {s.year}
            </p>
            <h3 id={`${s.id}-t`}>
              <span class="visually-hidden">{s.year}. </span>
              {s.law[lang]}
            </h3>
            <p class="sig-gz">{s.gazette[lang]}</p>
            <p class="sig-label">{s.alone ? it(lang, 'sigAlone') : it(lang, 'sigPosts')}</p>
            <ol class="sig-roles">
              {s.roles.map((r, j) => (
                <li>
                  <span class="n" aria-hidden="true">
                    {j + 1}
                  </span>
                  {r[lang]}
                </li>
              ))}
            </ol>
            <p class="sig-heading">{s.heading[lang]}</p>
            <button type="button" class="tile-btn" aria-expanded="false" aria-controls={s.id}>
              <span class="lb-open">＋ {it(lang, 'tileOpen')}</span>
              <span class="lb-close">− {it(lang, 'tileClose')}</span>
              <span class="visually-hidden">: {s.year}, {s.heading[lang]}</span>
            </button>
            <p class="sig-note">
              {s.note[lang]}
              <Cite lang={lang} ids={s.src} anchor={A.src} />
            </p>
          </div>
          <figure class="sig-doc">
            <div class="paper" data-hl>
              <Image
                src={s.image}
                alt={s.alt[lang]}
                widths={[480, 760, 1000]}
                sizes="(min-width: 900px) 560px, calc(100vw - 32px)"
                loading="lazy"
                decoding="async"
              />
              <div class="marks" aria-hidden="true">
                {s.boxes.map((b, j) => (
                  <span
                    class:list={['mark', `k-${b.k}`]}
                    style={`left:${b.x}%;top:${b.y}%;width:${b.w}%;height:${b.h}%;--d:${j * 260}ms`}
                  />
                ))}
              </div>
              {s.alone && <span class="stamp">{it(lang, 'sigAlone')}</span>}
            </div>
            <figcaption>
              {s.caption[lang]} {it(lang, 'sigHighlightNote')}
            </figcaption>
          </figure>
        </article>
      ))
    }
  </div>

  <div class="inv-essay sig-outro">
    <h3>{SIG_OUTRO.title[lang]}</h3>
    {SIG_OUTRO.text[lang].split('\n\n').map((p) => <p>{p}</p>)}
  </div>
</section>

<script>
  import { initTiles } from '../../scripts/tiles';
  initTiles('.sig [data-tiles]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const papers = document.querySelectorAll<HTMLElement>('.sig [data-hl]');
  if (!reduce && 'IntersectionObserver' in window) {
    papers.forEach((p) => p.classList.add('is-armed'));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-on');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -35% 0px', threshold: 0.35 },
    );
    papers.forEach((p) => io.observe(p));
  }
</script>

<style>
  .sig {
    padding-block: 56px 16px;
  }

  /* ledger: six signatures at a glance */
  .sig-ledger {
    max-width: var(--container);
    margin: 0 auto 40px;
    padding-inline: var(--gutter);
  }
  .sig-ledger ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    counter-reset: s;
  }
  @media (min-width: 720px) {
    .sig-ledger ol {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .sig-ledger ol {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
  .sig-ledger a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 12px 12px 14px;
    border: 1px solid var(--line);
    border-top: 3px solid var(--inv-hl-ink);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .sig-ledger a {
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }
    .sig-ledger a:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    }
  }
  .sig-ledger .alone a {
    border-top-color: var(--inv-sec);
  }
  .yr {
    font: 700 1.5rem/1 var(--serif);
  }
  .posts {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .post {
    font: 0.8rem/1.3 var(--sans);
    color: var(--muted);
  }
  .x2 {
    position: absolute;
    top: 10px;
    right: 10px;
    font: 700 0.8rem/1 var(--sans);
    padding: 4px 6px;
    border-radius: 999px;
    background: var(--inv-hl);
    color: #1d1600;
  }

  /* Phones: the ledger becomes the boxes themselves (see tiles below) */
  @media (max-width: 899.98px) {
    .sig-ledger {
      display: none;
    }
    :global(.tiles-on).sig-steps {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    :global(.tiles-on) .sig-step {
      position: relative;
      align-content: start;
      gap: 12px;
      padding: 14px 12px 12px;
      border: 1px solid var(--line);
      border-top: 3px solid var(--inv-hl-ink);
      border-radius: 10px;
      background: var(--surface);
      scroll-margin-top: calc(var(--inv-top) + var(--inv-toc-h) + 12px);
    }
    :global(.tiles-on) .sig-step.alone {
      border-top-color: var(--inv-sec);
    }
    :global(.tiles-on) .sig-step .sig-text {
      display: flex;
      flex-direction: column;
    }
    :global(.tiles-on) .sig-step:not(.is-open) .sig-text {
      gap: 6px;
      height: 100%;
    }
    :global(.tiles-on) .sig-step:not(.is-open) :is(.sig-gz, .sig-label, .sig-roles, .sig-note, .sig-doc) {
      display: none;
    }
    :global(.tiles-on) .sig-step:not(.is-open) h3 {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    :global(.tiles-on) .sig-step:not(.is-open) .sig-year {
      font-size: 2rem;
    }
    :global(.tiles-on) .sig-step:not(.is-open) .sig-heading {
      font-size: 0.98rem;
      line-height: 1.3;
    }
    :global(.tiles-on) .sig-step.is-open {
      grid-column: 1 / -1;
      padding: 16px;
    }
  }

  /* ---------- phones: boxes that expand on tap (JS on) ---------- */
  .tile-btn,
  .tile-hint {
    display: none;
  }
  @media (max-width: 899.98px) {
    :global(.tiles-on) .tile-hint {
      display: block;
      margin: 0 0 10px;
      padding-inline: var(--gutter);
      font: 600 0.85rem/1.4 var(--sans);
      color: var(--muted);
    }
    :global(.tiles-on) .tile-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      min-height: 32px;
      margin-top: auto;
      padding: 4px 12px;
      border: 1px solid currentColor;
      border-radius: 999px;
      background: transparent;
      color: inherit;
      font: 700 0.78rem/1 var(--sans);
      cursor: pointer;
    }
    /* collapsed: the whole box is the button */
    :global(.tiles-on) [data-tile]:not(.is-open) .tile-btn::after {
      content: '';
      position: absolute;
      inset: 0;
    }
    /* open: the close button goes to the top right of the card */
    :global(.tiles-on) [data-tile].is-open .tile-btn {
      order: -1;
      align-self: flex-end;
      margin: 0 0 4px;
    }
    .lb-close,
    :global(.tiles-on) [data-tile].is-open .lb-open {
      display: none;
    }
    :global(.tiles-on) [data-tile].is-open .lb-close {
      display: inline;
    }
  }
  /* steps */
  .sig-steps {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .sig-step {
    display: grid;
    gap: 16px;
    padding-block: 28px;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .sig-step {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 48px;
      align-items: center;
      padding-block: 44px;
    }
  }
  .sig-year {
    margin: 0;
    font: 700 clamp(2.6rem, 8vw, 5rem) / 0.9 var(--serif);
    color: var(--inv-hl-ink);
    letter-spacing: -0.03em;
  }
  .sig-step h3 {
    font-size: clamp(1.3rem, 2.6vw, 1.7rem);
    margin: 10px 0 6px;
  }
  .sig-gz {
    margin: 0 0 16px;
    font: 0.9rem/1.4 var(--sans);
    color: var(--muted);
  }
  .sig-label {
    margin: 0 0 6px;
    font: 700 0.75rem/1.4 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sig-roles {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .sig-roles li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    font: 600 1rem/1.35 var(--sans);
  }
  .sig-roles .n {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--inv-hl);
    color: #1d1600;
    font-size: 0.75rem;
  }
  .sig-heading {
    margin: 0 0 6px;
    font: 700 1.12rem/1.3 var(--serif);
    color: var(--ink);
  }
  .sig-note {
    font-family: var(--serif);
    font-size: 1.08rem;
    line-height: 1.6;
    margin: 0;
  }

  /* the document */
  .sig-doc {
    margin: 0;
  }
  .paper {
    position: relative;
    background: #fff;
    border-radius: 3px;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.12),
      0 12px 32px rgba(0, 0, 0, 0.14);
    overflow: hidden;
    transform: rotate(-0.4deg);
  }
  .sig-step:nth-child(even) .paper {
    transform: rotate(0.35deg);
  }
  .paper :global(img) {
    width: 100%;
    height: auto;
  }
  .marks {
    position: absolute;
    inset: 0;
  }
  .mark {
    position: absolute;
    border-radius: 3px 8px 4px 9px;
    background: linear-gradient(100deg, rgba(255, 214, 10, 0.42), rgba(255, 200, 0, 0.48) 40%, rgba(255, 214, 10, 0.4));
    transform-origin: left center;
  }
  .mark.k-name {
    background: linear-gradient(100deg, rgba(255, 205, 0, 0.52), rgba(255, 190, 0, 0.58) 50%, rgba(255, 205, 0, 0.5));
  }
  .paper.is-armed .mark {
    transform: scaleX(0);
    transition: transform 0.7s cubic-bezier(0.6, 0, 0.3, 1) var(--d);
  }
  .paper.is-armed.is-on .mark {
    transform: scaleX(1);
  }
  .stamp {
    position: absolute;
    left: 3%;
    bottom: 5%;
    transform: rotate(-8deg);
    padding: 6px 10px;
    border: 2px solid var(--inv-sec-fixed);
    border-radius: 4px;
    color: var(--inv-sec-fixed);
    font: 800 clamp(0.75rem, 1.6vw, 0.85rem) / 1.1 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.85);
  }
  .paper.is-armed .stamp {
    opacity: 0;
    transform: rotate(-8deg) scale(1.4);
    transition:
      opacity 0.3s ease 1.4s,
      transform 0.3s cubic-bezier(0.3, 1.6, 0.6, 1) 1.4s;
  }
  .paper.is-armed.is-on .stamp {
    opacity: 1;
    transform: rotate(-8deg) scale(1);
  }
  figcaption {
    margin-top: 10px;
    font: 0.8rem/1.45 var(--sans);
    color: var(--muted);
  }
</style>
