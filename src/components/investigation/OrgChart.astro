---
// "Who appoints whom". Desktop: a sticky SVG diagram with guided steps (scroll or Previous/Next) and a
// free mode; tapping a node lights up its links and opens its profile in a side sheet.
// Phones: a list by levels with the same profiles in a bottom sheet (no tiny diagram).
// Without JS: the diagram is static and every profile is open in the list.
import { getImage, Image } from 'astro:assets';
import type { Lang } from '../../i18n/ui';
import {
  EDGES,
  EDGE_TYPES,
  LEVELS,
  NODES,
  STEPS,
  type EdgeType,
  type OrgNode,
} from '../../data/investigations/who-commands-venezuela-2026';
import { ANCHORS, it } from '../../data/investigations/ui';
import Cite from './Cite.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const A = ANCHORS[lang];

const OX = 80; // left margin for level labels
const VBW = 1180;
const VBH = 920;
const R = 38;
const size = (n: OrgNode) =>
  n.kind === 'person'
    ? { w: R * 2, h: R * 2 }
    : n.kind === 'outcome'
      ? { w: 230, h: 58 }
      : { w: (n.id === 'fanb' ? 186 : n.id === 'consejos' ? 196 : 164) + (n.logo ? 44 : 0), h: 54 };

const byId = new Map(NODES.map((n) => [n.id, n]));
const X = (n: OrgNode) => n.x + OX;
const f = (v: number) => Math.round(v * 10) / 10;

function boundary(n: OrgNode, tx: number, ty: number) {
  const cx = X(n);
  const cy = n.y;
  const dx = tx - cx;
  const dy = ty - cy;
  if (n.kind === 'person') {
    const L = Math.hypot(dx, dy) || 1;
    return { x: cx + (dx / L) * (R + 5), y: cy + (dy / L) * (R + 5) };
  }
  const { w, h } = size(n);
  const t = Math.min(dx ? Math.abs((w / 2 + 4) / dx) : Infinity, dy ? Math.abs((h / 2 + 4) / dy) : Infinity);
  return { x: cx + dx * t, y: cy + dy * t };
}

const edges = EDGES.map((e, i) => {
  const a = byId.get(e.from)!;
  const b = byId.get(e.to)!;
  const p1 = boundary(a, X(b), b.y);
  const p2 = boundary(b, X(a), a.y);
  const dy = p2.y - p1.y;
  let c1, c2;
  if (Math.abs(dy) > 50) {
    c1 = { x: p1.x, y: p1.y + dy * 0.45 };
    c2 = { x: p2.x, y: p2.y - dy * 0.45 };
  } else {
    const mx = (p1.x + p2.x) / 2;
    const bend = 46;
    c1 = { x: mx, y: Math.min(p1.y, p2.y) - bend };
    c2 = c1;
  }
  const mid = {
    x: (p1.x + 3 * c1.x + 3 * c2.x + p2.x) / 8,
    y: (p1.y + 3 * c1.y + 3 * c2.y + p2.y) / 8,
  };
  const label = e.label[lang];
  return {
    ...e,
    i,
    d: `M${f(p1.x)} ${f(p1.y)} C${f(c1.x)} ${f(c1.y)} ${f(c2.x)} ${f(c2.y)} ${f(p2.x)} ${f(p2.y)}`,
    mid,
    label,
    lw: Math.min(380, label.length * 7.1 + 18),
  };
});

const portraits = Object.fromEntries(
  await Promise.all(
    NODES.filter((n) => n.photo).map(async (n) => {
      const img = await getImage({ src: n.photo!, width: 168, height: 168, format: 'webp', quality: 72 });
      return [n.id, img.src] as const;
    }),
  ),
);

const logos = Object.fromEntries(
  await Promise.all(
    NODES.filter((n) => n.logo).map(async (n) => {
      const img = await getImage({ src: n.logo!, width: 120, format: 'webp', quality: 80 });
      return [n.id, img.src] as const;
    }),
  ),
);

const typeLabel = (t: EdgeType) => EDGE_TYPES.find((x) => x.type === t)!.label[lang];
const nodeName = (id: string) => byId.get(id)!.name[lang];
const relations = (id: string) => ({
  up: EDGES.filter((e) => e.to === id && e.type !== 'family'),
  down: EDGES.filter((e) => e.from === id && e.type !== 'family'),
  ties: EDGES.filter((e) => (e.from === id || e.to === id) && e.type === 'family'),
});
const stepEdges = STEPS.map((s) => EDGES.filter((e) => s.nodes.includes(e.from) && s.nodes.includes(e.to)));
const levels = LEVELS.map((l, i) => ({ label: l[lang], nodes: NODES.filter((n) => n.level === i) }));
const levelY = [64, 200, 340, 500, 712, 850];

const swatch = (t: EdgeType) => t;
// Simple line icons for non-person nodes (24×24, stroked).
const ICONS: Record<string, string> = {
  inst: 'M3 21h18M4 10h16M5 10v8m4.67-8v8m4.66-8v8M19 10v8M12 3l8 5H4z',
  group: 'M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM2 20c0-3 2.7-5 6-5s6 2 6 5m-1.5-4.6C13.4 15.1 14.7 15 16 15c3.3 0 6 2 6 5',
  outcome: 'M12 3l9 16H3zM12 10v4m0 3v.5',
};
/** Long names go on two balanced lines under the portrait. */
const nameLines = (s: string) => {
  if (s.length <= 16) return [s];
  const w = s.split(' ');
  let best = [s];
  let diff = Infinity;
  for (let i = 1; i < w.length; i++) {
    const a = w.slice(0, i).join(' ');
    const b = w.slice(i).join(' ');
    const d = Math.abs(a.length - b.length);
    if (d < diff) {
      diff = d;
      best = [a, b];
    }
  }
  return best;
};
---

<section id={A.org} class="org" data-org data-mode="guided" data-step="0" aria-labelledby="org-title">
  <header class="inv-head">
    <p class="inv-kicker">{it(lang, 'orgKicker')}</p>
    <h2 id="org-title">{it(lang, 'orgTitle')}</h2>
    <p class="inv-intro">{it(lang, 'orgIntro')}</p>
  </header>

  <div class="org-controls">
    <div class="seg" role="group" aria-label={it(lang, 'modeLabel')}>
      <button type="button" data-mode-btn="guided" aria-pressed="true">{it(lang, 'modeGuided')}</button>
      <button type="button" data-mode-btn="free" aria-pressed="false">{it(lang, 'modeFree')}</button>
    </div>
    <fieldset class="filters">
      <legend>{it(lang, 'filters')}</legend>
      {
        EDGE_TYPES.map((t) => (
          <label class={`chip t-${t.type}`}>
            <input type="checkbox" checked data-filter={t.type} />
            <svg width="30" height="12" viewBox="0 0 30 12" aria-hidden="true">
              <line x1="1" y1="6" x2={t.type === 'appoint' || t.type === 'result' ? 22 : 29} y2="6" class={`sw sw-${swatch(t.type)}`} />
              {(t.type === 'appoint' || t.type === 'result') && <path d="M21 1 L29 6 L21 11 Z" class={`sw-head sw-${t.type}`} />}
            </svg>
            <span>{t.label[lang]}</span>
          </label>
        ))
      }
    </fieldset>
  </div>

  <div class="org-body">
    <div class="org-steps">
      {
        STEPS.map((s, i) => (
          <article class="org-step" data-i={i} aria-labelledby={`org-step-${i}`}>
            <p class="org-step-n">{it(lang, 'step', { n: i + 1, total: STEPS.length })}</p>
            <h3 id={`org-step-${i}`}>{s.title[lang].replace(/^\d+ · /, '')}</h3>
            <p>{s.text[lang]}</p>
            <ul class="rels">
              {stepEdges[i].map((e) => (
                <li class={`rel t-${e.type}`}>
                  <span class={`sw-dot sw-${e.type}`} aria-hidden="true" />
                  <span>
                    <strong>{nodeName(e.from)}</strong> {e.type === 'family' ? '—' : '→'} <strong>{nodeName(e.to)}</strong>:{' '}
                    {e.label[lang]} <span class="rel-type">({typeLabel(e.type)})</span>
                    <Cite lang={lang} ids={e.src} anchor={A.src} />
                  </span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
      <article class="org-step org-free-hint" data-i="free">
        <p>{it(lang, 'freeHint')}</p>
      </article>
    </div>

    <div class="org-stage">
      <svg
        class="org-svg"
        viewBox={`0 0 ${VBW} ${VBH}`}
        role="group"
        aria-label={it(lang, 'orgTitle')}
        focusable="false"
      >
        <defs>
          <marker id="m-appoint" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="11" markerHeight="11" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
            <path d="M0 0 L10 5 L0 10 Z" class="mk-appoint" />
          </marker>
          <marker id="m-result" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="10" markerHeight="10" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
            <path d="M0 0 L10 5 L0 10 Z" class="mk-result" />
          </marker>
          <clipPath id="clip-face" clipPathUnits="objectBoundingBox">
            <circle cx="0.5" cy="0.5" r="0.5" />
          </clipPath>
        </defs>

        <g class="lv" aria-hidden="true">
          {
            levels.map((l, i) => (
              <text x="6" y={levelY[i] + 4}>
                {i} · {l.label}
              </text>
            ))
          }
        </g>

        <g class="edges" aria-hidden="true">
          {
            edges.map((e) => (
              <path
                class={`edge t-${e.type}`}
                d={e.d}
                data-from={e.from}
                data-to={e.to}
                data-e={e.i}
                pathLength={e.type === 'appoint' || e.type === 'legal' || e.type === 'result' ? 1 : undefined}
                marker-end={e.type === 'appoint' ? 'url(#m-appoint)' : e.type === 'result' ? 'url(#m-result)' : undefined}
              />
            ))
          }
        </g>

        <g class="nodes">
          {
            NODES.map((n) => {
              const { w, h } = size(n);
              const cx = X(n);
              return (
                <a
                  class={`node k-${n.kind}`}
                  href={`#ficha-${n.id}`}
                  data-id={n.id}
                  style={`--lvl:${n.level}`}
                  aria-label={`${n.name[lang]}. ${n.role[lang]}. ${it(lang, 'open')}`}
                >
                  {n.kind === 'person' ? (
                    <g>
                      <circle class="ring" cx={cx} cy={n.y} r={R + 4} />
                      <circle class="face-bg" cx={cx} cy={n.y} r={R} />
                      {portraits[n.id] ? (
                        <image
                          href={portraits[n.id]}
                          x={cx - R}
                          y={n.y - R}
                          width={R * 2}
                          height={R * 2}
                          clip-path="url(#clip-face)"
                          preserveAspectRatio="xMidYMid slice"
                        />
                      ) : logos[n.id] ? (
                        <g>
                          <circle class="face-logo" cx={cx} cy={n.y} r={R} />
                          <image
                            href={logos[n.id]}
                            x={cx - R * 0.72}
                            y={n.y - R * 0.72}
                            width={R * 1.44}
                            height={R * 1.44}
                            preserveAspectRatio="xMidYMid meet"
                          />
                          <circle class="ini-chip" cx={cx + R * 0.74} cy={n.y + R * 0.7} r="15" />
                          <text class="ini-chip-t" x={cx + R * 0.74} y={n.y + R * 0.7 + 4.5} text-anchor="middle">
                            {n.initials}
                          </text>
                        </g>
                      ) : (
                        <text class="ini" x={cx} y={n.y + 8} text-anchor="middle">
                          {n.initials}
                        </text>
                      )}
                      <text class="nm" x={cx} y={n.y + R + 24} text-anchor="middle">
                        {nameLines(n.name[lang]).map((l, j) => (
                          <tspan x={cx} dy={j ? 19 : 0}>
                            {l}
                          </tspan>
                        ))}
                      </text>
                      <text class="sh" x={cx} y={n.y + R + 42 + (nameLines(n.name[lang]).length - 1) * 19} text-anchor="middle">
                        {n.short[lang]}
                      </text>
                    </g>
                  ) : (
                    <g>
                      <rect
                        class="box"
                        x={cx - w / 2}
                        y={n.y - h / 2}
                        width={w}
                        height={h}
                        rx={n.kind === 'outcome' ? h / 2 : 6}
                      />
                      {logos[n.id] && (
                        <image
                          href={logos[n.id]}
                          x={cx - w / 2 + 8}
                          y={n.y - 19}
                          width="38"
                          height="38"
                          preserveAspectRatio="xMidYMid meet"
                        />
                      )}
                      <text class="bx" x={logos[n.id] ? cx + 21 : cx} y={n.y + 6} text-anchor="middle">
                        {n.short[lang]}
                      </text>
                    </g>
                  )}
                </a>
              );
            })
          }
        </g>

        <g class="elabels" aria-hidden="true">
          {
            edges.map((e) => (
              <g class="elabel" data-e={e.i} transform={`translate(${f(e.mid.x)} ${f(e.mid.y)})`}>
                <rect x={-e.lw / 2} y="-13" width={e.lw} height="24" rx="12" />
                <text y="4" text-anchor="middle">
                  {e.label}
                </text>
              </g>
            ))
          }
        </g>
      </svg>

      <div class="stepper" data-stepper>
        <button type="button" data-prev>
          <span aria-hidden="true">←</span> {it(lang, 'prev')}
        </button>
        <p class="stepper-n" aria-live="polite" data-step-label>{it(lang, 'step', { n: 1, total: STEPS.length })}</p>
        <button type="button" data-next>
          {it(lang, 'next')} <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Phones and no-JS: the same structure as a list by levels, every profile complete. -->
  <div class="org-list">
    {
      levels.map((l, i) => (
        <section class="lvl" aria-labelledby={`lvl-${i}`}>
          <h3 id={`lvl-${i}`}>
            <span class="lvl-n">{i}</span> {l.label}
          </h3>
          <ul>
            {l.nodes.map((n) => {
              const rel = relations(n.id);
              return (
                <li class="item" data-id={n.id}>
                  <a class={`tile k-${n.kind}`} href={`#ficha-${n.id}`} data-open={n.id} aria-haspopup="dialog">
                    <span class="av" aria-hidden="true">
                      {n.photo ? (
                        <Image src={n.photo} alt="" width={112} height={112} loading="lazy" decoding="async" />
                      ) : n.logo ? (
                        <>
                          <Image class="av-logo" src={n.logo} alt="" width={96} loading="lazy" decoding="async" />
                          {n.initials && <span class="av-chip">{n.initials}</span>}
                        </>
                      ) : n.kind === 'person' ? (
                        <span class="av-ini">{n.initials}</span>
                      ) : (
                        <svg class="av-ico" viewBox="0 0 24 24" width="24" height="24">
                          <path d={ICONS[n.kind]} />
                        </svg>
                      )}
                    </span>
                    <span class="tile-t">
                      <strong>{n.name[lang]}</strong>
                      <span>{n.kind === 'person' ? n.short[lang] : n.role[lang]}</span>
                    </span>
                    <span class="tile-go" aria-hidden="true">
                      ›
                    </span>
                  </a>
                  <div class="ficha" id={`ficha-${n.id}`} data-ficha={n.id}>
                    <div class="f-head">
                      {n.photo ? (
                        <Image class="f-photo" src={n.photo} alt={n.name[lang]} width={176} height={176} loading="lazy" decoding="async" />
                      ) : n.logo ? (
                        <span class="f-logo" aria-hidden="true">
                          <Image src={n.logo} alt="" width={176} loading="lazy" decoding="async" />
                          {n.initials && <span class="av-chip">{n.initials}</span>}
                        </span>
                      ) : n.kind === 'person' ? (
                        <span class="f-ini" aria-hidden="true">
                          {n.initials}
                        </span>
                      ) : null}
                      <div>
                        <h4>{n.name[lang]}</h4>
                        <p class="f-role">{n.role[lang]}</p>
                      </div>
                    </div>
                    {n.photoCredit && <p class="f-credit">{n.photoCredit[lang]}</p>}
                    {n.logoCredit && <p class="f-credit">{n.logoCredit[lang]}</p>}
                    {rel.up.length > 0 && (
                      <>
                        <h5>{it(lang, 'appointedBy')}</h5>
                        <ul class="rels">
                          {rel.up.map((e) => (
                            <li class={`rel t-${e.type}`}>
                              <span class={`sw-dot sw-${e.type}`} aria-hidden="true" />
                              <span>
                                <strong>{nodeName(e.from)}</strong>: {e.label[lang]} <span class="rel-type">({typeLabel(e.type)})</span>
                                <Cite lang={lang} ids={e.src} anchor={A.src} />
                              </span>
                            </li>
                          ))}
                        </ul>
                      </>
                    )}
                    {rel.down.length > 0 && (
                      <>
                        <h5>{it(lang, 'appoints')}</h5>
                        <ul class="rels">
                          {rel.down.map((e) => (
                            <li class={`rel t-${e.type}`}>
                              <span class={`sw-dot sw-${e.type}`} aria-hidden="true" />
                              <span>
                                <strong>{nodeName(e.to)}</strong>: {e.label[lang]} <span class="rel-type">({typeLabel(e.type)})</span>
                                <Cite lang={lang} ids={e.src} anchor={A.src} />
                              </span>
                            </li>
                          ))}
                        </ul>
                      </>
                    )}
                    {rel.ties.length > 0 && (
                      <>
                        <h5>{it(lang, 'linksIn')}</h5>
                        <ul class="rels">
                          {rel.ties.map((e) => (
                            <li class={`rel t-${e.type}`}>
                              <span class={`sw-dot sw-${e.type}`} aria-hidden="true" />
                              <span>
                                <strong>{nodeName(e.from === n.id ? e.to : e.from)}</strong>: {e.label[lang]}
                                <Cite lang={lang} ids={e.src} anchor={A.src} />
                              </span>
                            </li>
                          ))}
                        </ul>
                      </>
                    )}
                    <h5>{it(lang, 'facts')}</h5>
                    <ul class="facts">
                      {n.facts.map((x) => (
                        <li>
                          {x.text[lang]}
                          {x.src.length ? <Cite lang={lang} ids={x.src} anchor={A.src} /> : null}
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }

    <div class="mbar" data-mbar>
      {
        STEPS.map((s, i) => (
          <div class="mbar-step" data-i={i}>
            <p class="mbar-t">{s.title[lang]}</p>
            <p class="mbar-p">{s.text[lang]}</p>
          </div>
        ))
      }
      <div class="mbar-step" data-i="free">
        <p class="mbar-p">{it(lang, 'freeHint')}</p>
      </div>
      <div class="mbar-nav">
        <button type="button" data-prev aria-label={it(lang, 'prev')}>←</button>
        <span data-step-label aria-live="polite">{it(lang, 'step', { n: 1, total: STEPS.length })}</span>
        <button type="button" data-next aria-label={it(lang, 'next')}>→</button>
      </div>
    </div>
  </div>

  <dialog class="sheet" data-sheet aria-label="">
    <div class="sheet-bar">
      <button type="button" class="sheet-close" data-close>
        <span aria-hidden="true">×</span>
        <span class="visually-hidden">{it(lang, 'close')}</span>
      </button>
    </div>
    <div class="sheet-body" data-sheet-body></div>
  </dialog>

  <script
    type="application/json"
    data-org-data
    set:html={JSON.stringify({
      steps: STEPS.map((s) => s.nodes),
      edges: EDGES.map((e) => [e.from, e.to]),
      labels: { step: it(lang, 'step', { n: '{n}', total: STEPS.length }) },
      names: Object.fromEntries(NODES.map((n) => [n.id, n.name[lang]])),
    })}
  />
</section>

<script>
  type OrgData = { steps: string[][]; edges: [string, string][]; labels: { step: string }; names: Record<string, string> };

  document.querySelectorAll<HTMLElement>('[data-org]').forEach((org) => {
    const data: OrgData = JSON.parse(org.querySelector('[data-org-data]')!.textContent!);
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const desktop = window.matchMedia('(min-width: 900px)');
    const svg = org.querySelector<SVGSVGElement>('.org-svg')!;
    const nodes = [...org.querySelectorAll<SVGAElement>('.node')];
    const edges = [...org.querySelectorAll<SVGPathElement>('.edge')];
    const labels = [...org.querySelectorAll<SVGGElement>('.elabel')];
    const items = [...org.querySelectorAll<HTMLElement>('.org-list .item')];
    const stepEls = [...org.querySelectorAll<HTMLElement>('.org-step')];
    const sheet = org.querySelector<HTMLDialogElement>('[data-sheet]')!;
    const sheetBody = org.querySelector<HTMLElement>('[data-sheet-body]')!;
    let step = 0;
    let selected: string | null = null;

    org.classList.add('is-live');

    function paint() {
      const guided = org.dataset.mode === 'guided';
      let on: Set<string> | null = null;
      if (selected) {
        on = new Set([selected]);
        data.edges.forEach(([a, b]) => {
          if (a === selected) on!.add(b);
          if (b === selected) on!.add(a);
        });
      } else if (guided) on = new Set(data.steps[step]);
      const edgeOn = (a: string, b: string) =>
        !on || (selected ? a === selected || b === selected : on.has(a) && on.has(b));
      nodes.forEach((n) => n.classList.toggle('is-dim', !!on && !on.has(n.dataset.id!)));
      nodes.forEach((n) => n.classList.toggle('is-sel', n.dataset.id === selected));
      items.forEach((n) => n.classList.toggle('is-dim', !!on && !on.has(n.dataset.id!)));
      edges.forEach((e, i) => {
        const [a, b] = data.edges[i];
        const active = edgeOn(a, b);
        e.classList.toggle('is-dim', !active);
        e.classList.toggle('is-on', active && !!on);
      });
      labels.forEach((l, i) => {
        const [a, b] = data.edges[i];
        l.classList.toggle('is-on', !!selected && (a === selected || b === selected));
      });
      org.dataset.step = guided ? String(step) : 'free';
      const text = data.labels.step.replace('{n}', String(step + 1));
      org.querySelectorAll<HTMLElement>('[data-step-label]').forEach((el) => (el.textContent = guided ? text : ''));
      org.querySelectorAll<HTMLButtonElement>('[data-prev]').forEach((b) => (b.disabled = !guided || step === 0));
      org.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((b) => (b.disabled = !guided || step === data.steps.length - 1));
    }

    function go(i: number, scroll: boolean) {
      step = Math.max(0, Math.min(data.steps.length - 1, i));
      selected = null;
      paint();
      if (scroll && desktop.matches) {
        stepEls[step]?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
      } else if (scroll) {
        const first = items.find((n) => !n.classList.contains('is-dim'));
        first?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
      }
    }

    function setMode(mode: 'guided' | 'free') {
      org.dataset.mode = mode;
      org.querySelectorAll<HTMLButtonElement>('[data-mode-btn]').forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.modeBtn === mode)),
      );
      selected = null;
      paint();
    }

    function open(id: string, opener: HTMLElement | SVGElement) {
      const src = org.querySelector<HTMLElement>(`[data-ficha="${id}"]`);
      if (!src) return;
      selected = id;
      paint();
      const clone = src.cloneNode(true) as HTMLElement;
      clone.removeAttribute('id');
      clone.querySelectorAll('[id]').forEach((el) => el.removeAttribute('id'));
      clone.querySelectorAll('img').forEach((img) => img.setAttribute('loading', 'eager'));
      sheetBody.replaceChildren(clone);
      sheet.setAttribute('aria-label', data.names[id]);
      sheet.showModal();
      sheet.querySelector<HTMLElement>('[data-close]')!.focus();
      sheet.addEventListener(
        'close',
        () => {
          selected = null;
          paint();
          (opener as HTMLElement).focus?.();
        },
        { once: true },
      );
    }

    // mode + filters
    org.querySelectorAll<HTMLButtonElement>('[data-mode-btn]').forEach((b) =>
      b.addEventListener('click', () => setMode(b.dataset.modeBtn as 'guided' | 'free')),
    );
    org.querySelectorAll<HTMLInputElement>('[data-filter]').forEach((c) =>
      c.addEventListener('change', () => org.classList.toggle(`hide-${c.dataset.filter}`, !c.checked)),
    );
    org.querySelectorAll<HTMLButtonElement>('[data-prev]').forEach((b) => b.addEventListener('click', () => go(step - 1, true)));
    org.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((b) => b.addEventListener('click', () => go(step + 1, true)));

    // open profiles
    nodes.forEach((n) =>
      n.addEventListener('click', (ev) => {
        ev.preventDefault();
        open(n.dataset.id!, n);
      }),
    );
    nodes.forEach((n) => {
      n.addEventListener('pointerenter', () => {
        if (sheet.open) return;
        labels.forEach((l, i) => {
          const [a, b] = data.edges[i];
          l.classList.toggle('is-hover', a === n.dataset.id || b === n.dataset.id);
        });
      });
      n.addEventListener('pointerleave', () => labels.forEach((l) => l.classList.remove('is-hover')));
    });
    org.querySelectorAll<HTMLAnchorElement>('[data-open]').forEach((a) =>
      a.addEventListener('click', (ev) => {
        ev.preventDefault();
        open(a.dataset.open!, a);
      }),
    );
    sheet.querySelector('[data-close]')!.addEventListener('click', () => sheet.close());
    sheet.addEventListener('click', (ev) => {
      if (ev.target === sheet) sheet.close(); // backdrop
      const link = (ev.target as HTMLElement).closest('a[href^="#"]');
      if (link) sheet.close();
    });

    // guided steps follow the scroll on desktop
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const i = (e.target as HTMLElement).dataset.i!;
            if (e.isIntersecting && i !== 'free' && org.dataset.mode === 'guided' && desktop.matches && !sheet.open) {
              step = Number(i);
              selected = null;
              paint();
            }
          }
        },
        { rootMargin: '-48% 0px -48% 0px' },
      );
      stepEls.forEach((s) => io.observe(s));

      // faces enter in order of command the first time the chart is seen
      if (!reduce) {
        svg.classList.add('is-armed');
        const io2 = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              svg.classList.add('is-in');
              io2.disconnect();
            }
          },
          { threshold: 0.2 },
        );
        io2.observe(svg);
      }
    }

    paint();
  });
</script>

